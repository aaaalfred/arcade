{
  "name": "@arcade/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build",
    "preview": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite preview",
    "typecheck": "tsc --noEmit",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "e2e": "playwright test",
    "cap": "cap",
    "native:assets": "node scripts/make-assets.mjs && capacitor-assets generate --assetPath resources --iconBackgroundColor \"#14161d\" --iconBackgroundColorDark \"#14161d\" --splashBackgroundColor \"#e9ecf1\" --splashBackgroundColorDark \"#14161c\" --android --ios",
    "native:sync": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite build && cap sync && node scripts/patch-native.mjs",
    "android:debug": "pnpm native:sync && cd android && ./gradlew assembleDebug",
    "android:release": "pnpm native:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@arcade/protocol": "workspace:*",
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@preact/signals": "^2.0.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^30.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.0.0"
  }
}
