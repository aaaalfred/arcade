# Variables de entorno de la API de Arcade. Copia este archivo a .env (NO lo subas al repo) o defínelas en Dokploy.
# La API no lee .env por sí sola: expórtalas en el shell o usa `node --env-file=.env dist/server.js`.

# Puerto HTTP (por defecto 8787)
PORT=8787

# --- Base de datos (elige UNA) ---
# Producción: Postgres. En Dokploy, usa la "Internal Connection URL" del servicio Postgres.
#DATABASE_URL=postgresql://arcade:CAMBIAME@arcade-db:5432/arcade
# Desarrollo: sin DATABASE_URL se usa PGlite (Postgres en proceso) guardado en esta carpeta (relativa al cwd).
#PGLITE_DIR=.data/pglite
# E2E / pruebas de integración: PGlite en memoria (se pierde al parar). Incompatible con DATABASE_URL.
#DB_MEMORY=1

# --- Catálogo de juegos ---
# Carpeta con games/<id>/manifest.json. Por defecto se busca ./games o ../../games (desde apps/api).
#GAMES_DIR=../../games
# 1 ⇒ incluye los juegos con "dev": true (p. ej. sdk-playground). En producción déjalo en 0.
INCLUDE_DEV_GAMES=0

# --- Moderación (opcional) ---
# Si se define (≥ 16 caracteres), activa /v1/admin/* con la cabecera x-admin-token. Genera uno con: openssl rand -hex 32
#ADMIN_TOKEN=

# --- Red ---
# Orígenes web extra permitidos por CORS, separados por comas. Los de la app (https://localhost y capacitor://localhost)
# ya están permitidos siempre; en desarrollo también http://localhost:*.
#CORS_ORIGINS=https://admin.ejemplo.com
# 1 ⇒ detrás de un proxy inverso (Dokploy/Traefik): la IP del cliente es el primer valor de x-forwarded-for
# (necesaria para el límite de 10 registros/hora/IP). Con 0 se usa la IP de la conexión.
TRUST_PROXY=0

# Lo fija el Dockerfile; desactiva los orígenes http://localhost:* de desarrollo
#NODE_ENV=production
